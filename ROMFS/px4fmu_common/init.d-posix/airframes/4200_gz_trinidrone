#!/bin/sh
#
# @name trinidrone Gazebo SITL
#
# @type Quadrotor x
# @class Copter
#
# [2026-09-07][trinidrone] Gazebo SITL (KdAero rev5)
#   상위문서 KD-MAIN-001 S1-4 와 동일 내용입니다.
#   두 곳을 따로 고치면 갈라지므로 한쪽만 정본으로 유지하십시오.
#
#   좌표계 : 노즈 = +z (FLU). PX4 표준 멀티콥터와 동일
#   기하   : 암반경 226mm → X배치 모멘트암 159.8mm
#   추진   : 700KV / 12S / 프롭 7x13 2엽 푸셔 / 캔트각 0

. ${R}etc/init.d/rc.vtol_defaults

# ── 시뮬레이터 지정 (SITL 전용) ──────────────────────────
PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=trinidrone}
param set-default SIM_GZ_EN 1

# ── Control Allocator : PX4 표준 쿼드 X ─────────────────
#   모터1 우측전방 CCW / 2 좌측후방 CCW / 3 좌측전방 CW / 4 우측후방 CW
#   0.1598 = 226/sqrt(2).  ★ 226 이 아님
param set-default MAV_TYPE 19          # VTOL Tailsitter Duorotor(19)/Quadrotor는 실제 타입 확인 필요*
param set-default VT_TYPE 0            # 0 = Tailsitter (VTOL 타입)
param set-default CA_AIRFRAME 4        # 테일시터용 control allocation
param set-default CA_ROTOR_COUNT 4
param set-default CA_SV_CS_COUNT 0     # 조종면 서보 0개 — 이게 핵심
param set-default VT_FW_DIFTHR_EN 7    # 전진비행 중 롤/피치/요 전부 차동추력으로 (비트마스크 7)

param set-default CA_ROTOR0_PX  0.1598
param set-default CA_ROTOR0_PY  0.1598
param set-default CA_ROTOR0_PZ  0.1640
param set-default CA_ROTOR0_KM  0.05

param set-default CA_ROTOR1_PX -0.1598
param set-default CA_ROTOR1_PY -0.1598
param set-default CA_ROTOR1_PZ  0.1640
param set-default CA_ROTOR1_KM  0.05

param set-default CA_ROTOR2_PX  0.1598
param set-default CA_ROTOR2_PY -0.1598
param set-default CA_ROTOR2_PZ  0.1640
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.1598
param set-default CA_ROTOR3_PY  0.1598
param set-default CA_ROTOR3_PZ  0.1640
param set-default CA_ROTOR3_KM -0.05

# ── gz 브리지 ★ SDF <cmd_min>/<cmd_max> 와 반드시 일치 ──
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104
param set-default SIM_GZ_EC_MIN1 150
param set-default SIM_GZ_EC_MIN2 150
param set-default SIM_GZ_EC_MIN3 150
param set-default SIM_GZ_EC_MIN4 150
param set-default SIM_GZ_EC_MAX1 1000
param set-default SIM_GZ_EC_MAX2 1000
param set-default SIM_GZ_EC_MAX3 1000
param set-default SIM_GZ_EC_MAX4 1000

# ── FC 장착 보정 (S3 에서 확정. 뒤집혀 보이면 25) ────────
#   SDF 의 imu_sensor / magnetometer_sensor pose 와 짝입니다.
#   SDF pitch -1.5708  <->  여기 24. 부호 반대가 정상
param set-default SENS_BOARD_ROT 0
param set-default EKF2_IMU_POS_X 0.0
param set-default EKF2_IMU_POS_Y 0.0
param set-default EKF2_IMU_POS_Z 0.0
param set-default EKF2_MAG_TYPE 0
param set-default EKF2_GPS_CTRL 7
param set-default CAL_MAG0_ROT -1


# ── 추력 ─────────────────────────────────────────────────
param set-default MPC_THR_HOVER 0.49
#   ★ 스로틀 선형화 OFF. KdAero 가 전기 모터 모델을 가져 이중 보정됨
param set-default THR_MDL_FAC 0.0

# ── 자세 포락선 (U6 에서 단계 확장) ─────────────────────
#   순항 트림 기울기는 약 87도입니다 (KD-SITL-M-001 2절).
#   단계 확장의 최종 목표를 79도가 아니라 87도로 잡으십시오.
param set-default MPC_TILTMAX_AIR 45
param set-default MPC_MAN_TILT_MAX 45

# ── 로깅 : 개발 단계는 부팅부터 ─────────────────────────
param set-default SDLOG_MODE 0
param set-default SDLOG_PROFILE 3

param set-default ASPD_PRIMARY 0
param set-default SYS_HAS_NUM_ASPD 0
param set-default FW_AIRSPD_MIN 30
param set-default FW_AIRSPD_TRIM 70
param set-default FW_AIRSPD_MAX 100
param set-default VT_ARSP_TRANS 32
param set-default VT_TRANS_TIMEOUT 30
param set-default VT_FW_MIN_ALT 20
param set-default FW_USE_AIRSPD 0
param set-default FW_PSP_OFF 12

#---------------------------------------------------------------
# [2026-09-15][trinidrone] guidance
#   The module itself does nothing until KD_G_EN is non zero,
#   so starting it unconditionally is safe.
#---------------------------------------------------------------
kd_guidance start
